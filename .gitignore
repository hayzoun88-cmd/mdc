# Le PDF de l'école reste en local (le dépôt est public)
*.pdf
__pycache__/
.DS_Store

# Captures d'écran (contiennent des photos de la classe) : ne jamais publier
Capture*
*.png
*.jpg
*.jpeg
*.heic

# Fichier local contenant le code du groupe : ne pas publier
requete-code-supabase.txt
correctif-lecture-supabase.txt
menage-supabase.txt
mise-a-jour-supabase.txt
message-classe.txt

# Clés privées des notifications push : ne jamais publier
.cles-notifications.json
activer-notifications-supabase.txt
connexion-supabase-terminal.txt

# Exception : les icônes de l'appli doivent être publiées
!icons/*.png

# Fichiers temporaires de la ligne de commande Supabase
supabase/.temp/
activer-admin-supabase.txt
mot-de-passe-admin.txt
mise-a-jour-mots-de-passe.txt
